{
  "name": "@dim/sdk",
  "description": "TypeScript SDK for DIM: the compiler, formatter, and zoom map from the Rust SDK, plus a web map component",
  "type": "module",
  "version": "0.2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js"
    },
    "./map.css": "./dist/map.css",
    "./wasm": "./wasm/dim_web_bg.wasm",
    "./vocab.json": "./wasm/vocab.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "typescript": "^6"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dim-language/dim-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "wasm",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/verify-runtime.mjs && tsc -p tsconfig.build.json && cp src/map/map.css dist/map.css",
    "check": "tsc --noEmit",
    "test": "bun test"
  }
}
